---
import Layout from '../../../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../../../i18n/utils';
import { getCollection } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { series } = Astro.params;

// Load all blog entries and filter by series
const blogEntries = await getCollection('blogs');
const seriesEntries = blogEntries.filter(entry => entry.id.startsWith(`${series}/`));

// Get series info from the first entry
const seriesTitle = seriesEntries[0]?.data.series || series;
const seriesCover = `/images/blog-series/${series}.jpg`;

// Sort posts by date (descending)
const posts = seriesEntries
  .map(entry => ({
    ...entry.data,
    slug: entry.id.split('/')[1],
    zhihuLink: entry.data.zhihuLink,
    wechatLink: entry.data.wechatLink,
  }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

export async function getStaticPaths() {
  const blogs = await getCollection('blogs');
  const seriesSet = new Set(blogs.map(entry => entry.id.split('/')[0]));
  return Array.from(seriesSet).map(s => ({ params: { series: s } }));
}
---

<Layout title={seriesTitle}>
  <div class="mb-6">
    <a href="/zh/blogs" class="text-sm text-blue-600 dark:text-blue-400 hover:underline">
      ← {t('nav.blogs')}
    </a>
  </div>

  <div class="flex items-center gap-4 mb-8">
    <img
      src={seriesCover}
      alt={seriesTitle}
      class="w-24 h-24 rounded-lg object-cover"
    />
    <div>
      <h1 class="text-3xl font-bold">{seriesTitle}</h1>
      <p class="text-gray-600 dark:text-gray-400 mt-1">{posts.length} 篇文章</p>
    </div>
  </div>

  <div class="space-y-4">
    {posts.map((post) => (
      <article class="bg-white dark:bg-gray-900 rounded-lg shadow-sm border border-gray-200 dark:border-gray-800 overflow-hidden hover:shadow-md transition-shadow">
        <div class="flex">
          <!-- Post Cover -->
          <div class="w-48 flex-shrink-0">
            <img
              src={post.cover}
              alt={post.title}
              class="w-full h-full object-cover aspect-[4/3]"
            />
          </div>
          <!-- Post Content -->
          <div class="flex-1 p-4">
            <div class="flex items-start justify-between">
              <div class="flex-1">
                <h2 class="text-lg font-semibold mb-2">
                  <a href={`/zh/blogs/${series}/${post.slug}`}
                     class="text-blue-600 dark:text-blue-400 hover:underline">
                    {post.title}
                  </a>
                </h2>

                <div class="flex items-center gap-4 text-sm text-gray-500 dark:text-gray-500 mb-2">
                  <span>{post.date.toLocaleDateString('zh-CN')}</span>
                  <span>·</span>
                  <span>{post.readTime} {t('blogs.minutes')}</span>
                </div>
                <!-- Tags -->
                {post.tags && post.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2">
                    {post.tags.map((tag) => (
                      <a
                        href={`/zh/blogs/tag/${encodeURIComponent(tag)}`}
                        class="text-xs px-2 py-1 bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 rounded hover:bg-blue-100 dark:hover:bg-blue-900 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                      >
                        #{tag}
                      </a>
                    ))}
                  </div>
                )}
              </div>

              <!-- External Links (Top Right) -->
              {(post.zhihuLink || post.wechatLink) && (
                <div class="flex gap-3 text-sm ml-4">
                  {post.zhihuLink && (
                    <a 
                      href={post.zhihuLink} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="text-blue-600 dark:text-blue-400 hover:underline"
                    >
                      {t('blogs.zhihu')} ↗
                    </a>
                  )}
                  {post.wechatLink && (
                    <a 
                      href={post.wechatLink} 
                      target="_blank" 
                      rel="noopener noreferrer"
                      class="text-green-600 dark:text-green-400 hover:underline"
                    >
                      {t('blogs.wechat')} ↗
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</Layout>