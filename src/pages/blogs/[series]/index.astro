---
import Layout from '../../../layouts/Layout.astro';
import { useTranslations } from '../../../i18n/utils';
import { getCollection } from 'astro:content';

const lang = 'en';
const t = useTranslations(lang);

const { series } = Astro.params;

// Load all blog entries and filter by series
const blogEntries = await getCollection('blogs');
const seriesEntries = blogEntries.filter(entry => entry.id.startsWith(`${series}/`));

// Get series info from the first entry
const seriesTitle = seriesEntries[0]?.data.series || series;
const seriesCover = `/images/blog-series/${series}.jpg`;

// Sort posts by date (descending)
const posts = seriesEntries
  .map(entry => ({
    ...entry.data,
    slug: entry.id.split('/')[1],
  }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

export async function getStaticPaths() {
  const blogs = await getCollection('blogs');
  const seriesSet = new Set(blogs.map(entry => entry.id.split('/')[0]));
  return Array.from(seriesSet).map(s => ({ params: { series: s } }));
}
---

<Layout title={seriesTitle}>
  <div class="mb-6">
    <a href="/blogs" class="text-sm text-blue-600 dark:text-blue-400 hover:underline">
      ← {t('nav.blogs')}
    </a>
  </div>

  <div class="flex items-center gap-4 mb-8">
    <img
      src={seriesCover}
      alt={seriesTitle}
      class="w-24 h-24 rounded-lg object-cover"
    />
    <div>
      <h1 class="text-3xl font-bold">{seriesTitle}</h1>
      <p class="text-gray-600 dark:text-gray-400 mt-1">{posts.length} posts</p>
    </div>
  </div>

  <div class="space-y-4">
    {posts.map((post) => (
      <article class="bg-white dark:bg-gray-900 rounded-lg shadow-sm border border-gray-200 dark:border-gray-800 p-4 hover:shadow-md transition-shadow">
        <div class="flex items-start justify-between">
          <div class="flex-1">
            <h2 class="text-lg font-semibold mb-2">
              <a href={`/blogs/${series}/${post.slug}`}
                 class="text-blue-600 dark:text-blue-400 hover:underline">
                {post.title}
              </a>
            </h2>

            <div class="flex items-center gap-4 text-sm text-gray-500 dark:text-gray-500">
              <span>{post.date.toLocaleDateString('en-US')}</span>
              <span>·</span>
              <span>{post.readTime} {t('blogs.minutes')}</span>
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</Layout>