---
import Layout from '../../../layouts/Layout.astro';
import { useTranslations } from '../../../i18n/utils';
import { getCollection } from 'astro:content';

const lang = 'en';
const t = useTranslations(lang);

const { tag } = Astro.params;

// Load all blog entries and filter by tag
const blogEntries = await getCollection('blogs');
const taggedEntries = blogEntries.filter(entry => 
  entry.data.tags?.includes(tag as string)
);

// Sort by date (descending)
const posts = taggedEntries
  .map(entry => ({
    ...entry.data,
    slug: entry.id.split('/')[1],
    series: entry.id.split('/')[0],
    zhihuLink: entry.data.zhihuLink,
    wechatLink: entry.data.wechatLink,
  }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

// Get all unique tags for sidebar
const allTags = [...new Set(blogEntries.flatMap(entry => entry.data.tags || []))];

export async function getStaticPaths() {
  const blogs = await getCollection('blogs');
  const tags = [...new Set(blogs.flatMap(entry => entry.data.tags || []))];
  return tags.map(tag => ({ params: { tag } }));
}
---

<Layout title={`Tag: ${tag}`}>
  <div class="mb-6">
    <a href="/blogs" class="text-sm text-blue-600 dark:text-blue-400 hover:underline">
      ← {t('nav.blogs')}
    </a>
  </div>

  <div class="flex gap-8">
    <!-- Main Content -->
    <div class="flex-1">
      <div class="mb-8">
        <h1 class="text-3xl font-bold mb-2">#{tag}</h1>
        <p class="text-gray-600 dark:text-gray-400">{posts.length} posts</p>
      </div>

      <div class="space-y-4">
        {posts.map((post) => (
          <article class="bg-white dark:bg-gray-900 rounded-lg shadow-sm border border-gray-200 dark:border-gray-800 overflow-hidden hover:shadow-md transition-shadow">
            <div class="flex">
              <!-- Post Cover -->
              <div class="w-48 flex-shrink-0">
                <img
                  src={post.cover}
                  alt={post.title}
                  class="w-full h-full object-cover aspect-[4/3]"
                />
              </div>
              <!-- Post Content -->
              <div class="flex-1 p-4">
                <div class="flex items-start justify-between">
                  <div class="flex-1">
                    <h2 class="text-lg font-semibold mb-2">
                      <a href={`/blogs/${post.series}/${post.slug}`}
                         class="text-blue-600 dark:text-blue-400 hover:underline">
                        {post.title}
                      </a>
                    </h2>

                    <div class="flex items-center gap-4 text-sm text-gray-500 dark:text-gray-500 mb-2">
                      <span>{post.date.toLocaleDateString('en-US')}</span>
                      <span>·</span>
                      <span>{post.readTime} {t('blogs.minutes')}</span>
                    </div>
                    
                    <!-- Tags -->
                    {post.tags && post.tags.length > 0 && (
                      <div class="flex flex-wrap gap-2">
                        {post.tags.map((t) => (
                          <a
                            href={`/blogs/tag/${encodeURIComponent(t)}`}
                            class={`text-xs px-2 py-1 rounded transition-colors ${
                              t === tag 
                                ? 'bg-blue-100 dark:bg-blue-900 text-blue-600 dark:text-blue-400' 
                                : 'bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-blue-100 dark:hover:bg-blue-900 hover:text-blue-600 dark:hover:text-blue-400'
                            }`}
                          >
                            #{t}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>

                  <!-- External Links (Top Right) -->
                  {(post.zhihuLink || post.wechatLink) && (
                    <div class="flex gap-3 text-sm ml-4">
                      {post.zhihuLink && (
                        <a 
                          href={post.zhihuLink} 
                          target="_blank" 
                          rel="noopener noreferrer"
                          class="text-blue-600 dark:text-blue-400 hover:underline"
                        >
                          {t('blogs.zhihu')} ↗
                        </a>
                      )}
                      {post.wechatLink && (
                        <a 
                          href={post.wechatLink} 
                          target="_blank" 
                          rel="noopener noreferrer"
                          class="text-green-600 dark:text-green-400 hover:underline"
                        >
                          {t('blogs.wechat')} ↗
                        </a>
                      )}
                    </div>
                  )}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <!-- Sidebar - All Tags -->
    <aside class="w-64 hidden lg:block">
      <div class="bg-white dark:bg-gray-900 rounded-lg shadow-sm border border-gray-200 dark:border-gray-800 p-4 sticky top-4">
        <h3 class="font-semibold mb-4 text-gray-900 dark:text-white">All Tags</h3>
        <div class="flex flex-wrap gap-2">
          {allTags.map((t) => (
            <a
              href={`/blogs/tag/${encodeURIComponent(t)}`}
              class={`text-xs px-2 py-1 rounded transition-colors ${
                t === tag 
                  ? 'bg-blue-100 dark:bg-blue-900 text-blue-600 dark:text-blue-400' 
                  : 'bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-blue-100 dark:hover:bg-blue-900 hover:text-blue-600 dark:hover:text-blue-400'
              }`}
            >
              #{t}
            </a>
          ))}
        </div>
      </div>
    </aside>
  </div>
</Layout>
