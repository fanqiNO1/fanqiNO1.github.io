---
import Layout from '../../../layouts/Layout.astro';
import { useTranslations } from '../../../i18n/utils';
import { getCollection } from 'astro:content';

const lang = 'en';
const t = useTranslations(lang);

// Load all blog entries
const blogEntries = await getCollection('blogs');

// Get all tags with count
const tagCounts = blogEntries.reduce((acc, entry) => {
  entry.data.tags?.forEach(tag => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {} as Record<string, number>);

// Sort by count (descending)
const sortedTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1]);

// Calculate font size based on count
const maxCount = Math.max(...Object.values(tagCounts));
const minCount = Math.min(...Object.values(tagCounts));
---

<Layout title="Tags">
  <div class="mb-6">
    <a href="/blogs" class="text-sm text-blue-600 dark:text-blue-400 hover:underline">
      ← {t('nav.blogs')}
    </a>
  </div>

  <div class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold mb-4 text-center">Tags</h1>
    <p class="text-gray-600 dark:text-gray-400 text-center mb-8">
      {sortedTags.length} tags · {blogEntries.length} posts
    </p>

    <!-- Tag Cloud -->
    <div class="flex flex-wrap justify-center gap-3">
      {sortedTags.map(([tag, count]) => {
        const size = minCount === maxCount 
          ? 1 
          : 0.8 + ((count - minCount) / (maxCount - minCount)) * 0.7;
        return (
          <a
            href={`/blogs/tag/${encodeURIComponent(tag)}`}
            class="inline-block px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 rounded-full hover:bg-blue-100 dark:hover:bg-blue-900 hover:text-blue-600 dark:hover:text-blue-400 transition-all duration-200"
            style={`font-size: ${size}rem;`}
          >
            #{tag}
            <span class="text-xs text-gray-500 dark:text-gray-400 ml-1">({count})</span>
          </a>
        );
      })}
    </div>
  </div>
</Layout>
