---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';
import { getCollection } from 'astro:content';

const lang = 'en';
const t = useTranslations(lang);

// Load all blog posts
const blogEntries = await getCollection('blogs');

// Group by series and calculate stats
const seriesMap = new Map<string, {
  slug: string;
  title: string;
  posts: typeof blogEntries;
  lastUpdated: Date;
  cover: string;
}>();

blogEntries.forEach((entry) => {
  const seriesSlug = entry.id.split('/')[0];
  const seriesTitle = entry.data.series;
  
  if (!seriesMap.has(seriesSlug)) {
    seriesMap.set(seriesSlug, {
      slug: seriesSlug,
      title: seriesTitle,
      posts: [],
      lastUpdated: entry.data.date,
      cover: `/images/blog-series/${seriesSlug}.jpg`,
    });
  }
  
  const series = seriesMap.get(seriesSlug)!;
  series.posts.push(entry);
  if (entry.data.date > series.lastUpdated) {
    series.lastUpdated = entry.data.date;
  }
});

// Convert to array and sort by last updated (descending)
const blogSeries = Array.from(seriesMap.values())
  .map((series) => {
    const sortedPosts = series.posts.sort((a, b) => 
      new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
    );
    const latestPost = sortedPosts[0];
    
    return {
      ...series,
      postCount: series.posts.length,
      lastPostTitle: latestPost.data.title,
      lastPostSlug: latestPost.id.split('/')[1],
      description: `${series.posts.length} posts`,
    };
  })
  .sort((a, b) => new Date(b.lastUpdated).getTime() - new Date(a.lastUpdated).getTime());
---

<Layout title={t('nav.blogs')}>
  <h1 class="text-3xl font-bold mb-8">{t('nav.blogs')}</h1>

  <div class="space-y-6">
    {blogSeries.map((series) => (
      <a href={`/blogs/${series.slug}`} class="block">
        <article class="flex gap-6 bg-white dark:bg-gray-900 rounded-lg shadow-sm border border-gray-200 dark:border-gray-800 overflow-hidden hover:shadow-md transition-shadow">
          <!-- Cover Image -->
          <div class="relative w-64 flex-shrink-0">
            <img
              src={series.cover}
              alt={series.title}
              class="w-full h-full object-cover aspect-video"
            />
            <div class="absolute top-2 left-2">
              <span class="px-2 py-1 text-xs font-medium bg-purple-600 text-white rounded">
                {series.postCount} posts
              </span>
            </div>
          </div>

          <!-- Content -->
          <div class="flex-1 p-4">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">
              {series.title}
            </h2>

            <p class="text-sm text-gray-600 dark:text-gray-400 mb-3">
              {series.description}
            </p>

            <div class="text-sm text-gray-500 dark:text-gray-500">
              <span class="font-medium">{t('blogs.lastUpdated')}:</span>
              <span>{series.lastUpdated.toLocaleDateString('en-US')}</span>
              <span class="mx-2">·</span>
              <span class="text-blue-600 dark:text-blue-400">
                {series.lastPostTitle}
              </span>
            </div>
          </div>
        </article>
      </a>
    ))}
  </div>
</Layout>