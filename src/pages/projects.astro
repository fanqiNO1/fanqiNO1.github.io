---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';
import { getCollection } from 'astro:content';

const lang = 'en';
const t = useTranslations(lang);

// Load and sort projects by date (descending)
const projects = await getCollection('projects');
const sortedProjects = projects
  .map(entry => ({ ...entry.data, id: entry.id }))
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());
---

<Layout title={t('nav.projects')}>
  <h1 class="text-3xl font-bold mb-8">{t('nav.projects')}</h1>

  <div class="space-y-6">
    {sortedProjects.map((project) => (
      <article class="flex gap-6 bg-white dark:bg-gray-900 rounded-lg shadow-sm border border-gray-200 dark:border-gray-800 overflow-hidden hover:shadow-md transition-shadow">
        <!-- Cover Image -->
        <div class="relative w-64 flex-shrink-0">
          <img
            src={project.cover}
            alt={project.title}
            class="w-full h-full object-cover aspect-video"
          />
          <div class="absolute top-2 left-2 flex gap-1">
            {project.tags.map((tag) => (
              <span class="px-2 py-1 text-xs font-medium bg-green-600 text-white rounded">
                {tag}
              </span>
            ))}
          </div>
        </div>

        <!-- Content -->
        <div class="flex-1 p-4">
          <div class="flex items-center gap-3 mb-2">
            <h2 class="text-lg font-semibold">
              {project.github ? (
                <a href={project.github} target="_blank" rel="noopener noreferrer"
                   class="text-blue-600 dark:text-blue-400 hover:underline">
                  {project.title}
                </a>
              ) : (
                <span class="text-gray-900 dark:text-white">{project.title}</span>
              )}
            </h2>
            {project.stars && (
              <span class="inline-flex items-center gap-1 px-2 py-0.5 text-xs font-medium bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200 rounded">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
                {project.stars}
              </span>
            )}
          </div>

          <p class="text-sm text-gray-600 dark:text-gray-400 mb-2">
            {project.description}
          </p>

          <p class="text-sm text-gray-500 dark:text-gray-500 mb-3">
            {project.date.getFullYear()}
          </p>

          <div class="flex gap-3">
            {project.github && (
              <a href={project.github} target="_blank" rel="noopener noreferrer"
                 class="text-sm text-blue-600 dark:text-blue-400 hover:underline">
                GitHub
              </a>
            )}
            {project.demo && (
              <a href={project.demo} target="_blank" rel="noopener noreferrer"
                 class="text-sm text-blue-600 dark:text-blue-400 hover:underline">
                Demo
              </a>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
</Layout>