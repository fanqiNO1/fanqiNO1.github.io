---
import Layout from '../layouts/Layout.astro';
import { useTranslations } from '../i18n/utils';

const lang = 'en';
const t = useTranslations(lang);

const cvFile = '/cv/cv-en.pdf';
---

<Layout title={t('nav.cv')}>
  <h1 class="text-3xl font-bold mb-8">{t('nav.cv')}</h1>

  <!-- PDF Preview -->
  <div class="bg-white dark:bg-gray-900 rounded-lg shadow-sm border border-gray-200 dark:border-gray-800 overflow-hidden">
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200 dark:border-gray-800">
      <div class="flex items-center gap-4">
        <span class="text-sm font-medium text-blue-600 dark:text-blue-400">
          English CV
        </span>
        <span class="text-gray-300 dark:text-gray-600">|</span>
        <a
          href="/zh/cv"
          class="text-sm font-medium text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
        >
          中文简历
        </a>
      </div>
      <a
        href={cvFile}
        target="_blank"
        class="text-sm text-blue-600 dark:text-blue-400 hover:underline"
      >
        {t('cv.openInNewTab')}
      </a>
    </div>

    <div class="w-full aspect-[1/1.414] bg-gray-100 dark:bg-gray-800">
      <object
        data={cvFile}
        type="application/pdf"
        class="w-full h-full"
      >
        <div class="flex items-center justify-center h-full text-gray-500 dark:text-gray-400">
          <p class="text-center">
            Unable to display PDF preview<br>
            <a href={cvFile} target="_blank" class="text-blue-600 dark:text-blue-400 hover:underline">
              Click here to open in new tab
            </a>
          </p>
        </div>
      </object>
    </div>
  </div>
</Layout>
