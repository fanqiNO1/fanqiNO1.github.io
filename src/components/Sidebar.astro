---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { readFileSync } from 'fs';
import { resolve } from 'path';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Read sidebar config from public directory
const configPath = resolve('./public/config/sidebar.json');
const configRaw = readFileSync(configPath, 'utf-8');
const config = JSON.parse(configRaw);

// Get localized values
const name = typeof config.name === 'object'
  ? config.name[lang as keyof typeof config.name]
  : config.name;

const tagline = typeof config.tagline === 'object'
  ? config.tagline[lang as keyof typeof config.tagline]
  : config.tagline;

const location = typeof config.location === 'object'
  ? config.location[lang as keyof typeof config.location]
  : config.location;

const school = typeof config.school === 'object'
  ? config.school[lang as keyof typeof config.school]
  : config.school;

// Font Awesome icon mapping for known platforms
const iconMap: Record<string, { icon: string; label: string }> = {
  'googleScholar': { icon: 'fab fa-google-scholar', label: 'Google Scholar' },
  'orcid': { icon: 'fab fa-orcid', label: 'ORCID' },
  'github': { icon: 'fab fa-github', label: 'GitHub' },
  'zhihu': { icon: 'fab fa-zhihu', label: lang === 'zh' ? '知乎' : 'Zhihu' },
};

// Build links array from simplified config
const links = Object.entries(config.links)
  .filter(([_, url]) => url && typeof url === 'string')
  .map(([key, url]) => ({
    key,
    url: url as string,
    icon: iconMap[key]?.icon || 'fas fa-link',
    label: iconMap[key]?.label || key,
  }));
---

<aside class="w-72 bg-white dark:bg-gray-900 border-r border-gray-200 dark:border-gray-800 min-h-screen p-6 flex flex-col sticky top-0">
  <!-- Avatar -->
  <div class="flex flex-col items-center mb-6">
    <div class="w-32 h-32 rounded-full overflow-hidden mb-4 ring-4 ring-gray-100 dark:ring-gray-800">
      <img src={config.avatar} alt={name} class="w-full h-full object-cover" />
    </div>
    <h2 class="text-xl font-bold text-gray-900 dark:text-white">{name}</h2>
    {tagline && (
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400 text-center">{tagline}</p>
    )}
  </div>

  <!-- Info -->
  <div class="space-y-3 mb-6 text-sm">
    <div class="flex items-center gap-2 text-gray-600 dark:text-gray-400">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
      <span>{location}</span>
    </div>
    <div class="flex items-center gap-2 text-gray-600 dark:text-gray-400">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z"/>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/>
      </svg>
      <span>{school}</span>
    </div>
  </div>

  <!-- Links -->
  <div class="border-t border-gray-200 dark:border-gray-800 pt-4">
    <h3 class="text-xs font-semibold text-gray-500 dark:text-gray-500 uppercase tracking-wider mb-3">
      {t('sidebar.links')}
    </h3>
    <div class="space-y-2 text-sm">
      {links.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
        >
          <i class={`${link.icon} w-4 text-center text-xs`}></i>
          <span>{link.label}</span>
        </a>
      ))}
    </div>
  </div>
</aside>